{
  "name": "docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build && pnpm exec pagefind --site dist/client",
    "preview": "vike build && pnpm exec pagefind --site dist/client && vike preview",
    "check-links": "tsx scripts/check-links.mts"
  },
  "dependencies": {
    "@functional-examples/documentation": "workspace:*",
    "@functional-examples/javascript": "workspace:*",
    "@functional-examples/test": "workspace:*",
    "@functional-examples/yaml-manifest": "workspace:*",
    "@icons-pack/react-simple-icons": "^13.11.2",
    "functional-examples": "workspace:*",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-github-alerts": "^4.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-typedoc": "workspace:*",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "@shikijs/rehype": "^3.21.0",
    "shiki": "^3.21.0",
    "unified": "^11.0.5",
    "vike": "^0.4.252",
    "vike-plugin-typedoc": "workspace:*",
    "vike-react": "^0.6.19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "@untitaker/hyperlink": "0.2.0"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "^extract-docs"
        ]
      },
      "deploy": {
        "executor": "nx-github-pages:deploy",
        "options": {
          "directory": "{projectRoot}/dist/client"
        }
      },
      "check-links": {
        "dependsOn": [
          "build"
        ]
      }
    },
    "implicitDependencies": [
      "functional-examples",
      "@functional-examples/javascript",
      "@functional-examples/yaml-manifest",
      "@functional-examples/test",
      "@functional-examples/documentation",
      "rehype-typedoc",
      "vike-plugin-typedoc"
    ]
  }
}
