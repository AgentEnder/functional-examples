<span style=\"color:#8FA4BE\">{</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">extends</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">../../tsconfig.base.json</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">compilerOptions</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    \"</span><span style=\"color:#A8D0F0\">types</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#7CC9A0\">node</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">],</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    \"</span><span style=\"color:#A8D0F0\">noEmit</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#D4A94E\"> true</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  },</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">include</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#7CC9A0\">src/**/*.ts</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">.functional-examples/*.d.ts</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">]</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">}</span></span>\n<span class=\"line\"></span></code></pre>"},{"absolutePath":"/home/runner/work/functional-examples/functional-examples/examples/mixed-plugins/src/utils.ts","relativePath":"src/utils.ts","raw":"// ---\n// id: mixed-utils\n// title: Utility Functions\n// description: Example using frontmatter in a mixed-plugin project\n// ---\n\n/**\n * Format a number as currency\n */\nexport function formatCurrency(amount: number, currency = 'USD'): string {\n  return new Intl.NumberFormat('en-US', {\n    style: 'currency',\n    currency,\n  }).format(amount);\n}\n\n/**\n * Format a date\n */\nexport function formatDate(date: Date): string {\n  return new Intl.DateTimeFormat('en-US').format(date);\n}\n","parsed":"// ---\n// id: mixed-utils\n// title: Utility Functions\n// description: Example using frontmatter in a mixed-plugin project\n// ---\n\n/**\n * Format a number as currency\n */\nexport function formatCurrency(amount: number, currency = 'USD'): string {\n  return new Intl.NumberFormat('en-US', {\n    style: 'currency',\n    currency,\n  }).format(amount);\n}\n\n/**\n * Format a date\n */\nexport function formatDate(date: Date): string {\n  return new Intl.DateTimeFormat('en-US').format(date);\n}\n","hunks":[],"language":"typescript","highlightedHtml":"<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-typescript\"><span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">// ---</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">// id: mixed-utils</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">// title: Utility Functions</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">// description: Example using frontmatter in a mixed-plugin project</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">// ---</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">/**</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> * Format a number as currency</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> */</span></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">export</span><span style=\"color:#8EC8E8\"> function</span><span style=\"color:#B8D8F0\"> formatCurrency</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#C8D8E8\">amount</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#A8D0F0\"> number</span><span style=\"color:#8FA4BE\">,</span><span style=\"color:#C8D8E8\"> currency</span><span style=\"color:#8FA4BE\"> =</span><span style=\"color:#8FA4BE\"> '</span><span style=\"color:#7CC9A0\">USD</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#8FA4BE\">):</span><span style=\"color:#A8D0F0\"> string</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">  return</span><span style=\"color:#8FA4BE\"> new</span><span style=\"color:#E8EDF4\"> Intl</span><span style=\"color:#8FA4BE\">.</span><span style=\"color:#B8D8F0\">NumberFormat</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#7CC9A0\">en-US</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#8FA4BE\">,</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E8EDF4\">    style</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> '</span><span style=\"color:#7CC9A0\">currency</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#E8EDF4\">    currency</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  }).</span><span style=\"color:#B8D8F0\">format</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#E8EDF4\">amount</span><span style=\"color:#8FA4BE\">);</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">/**</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> * Format a date</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> */</span></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">export</span><span style=\"color:#8EC8E8\"> function</span><span style=\"color:#B8D8F0\"> formatDate</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#C8D8E8\">date</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#A8D0F0\"> Date</span><span style=\"color:#8FA4BE\">):</span><span style=\"color:#A8D0F0\"> string</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">  return</span><span style=\"color:#8FA4BE\"> new</span><span style=\"color:#E8EDF4\"> Intl</span><span style=\"color:#8FA4BE\">.</span><span style=\"color:#B8D8F0\">DateTimeFormat</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#7CC9A0\">en-US</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#8FA4BE\">).</span><span style=\"color:#B8D8F0\">format</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#E8EDF4\">date</span><span style=\"color:#8FA4BE\">);</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">}</span></span>\n<span class=\"line\"></span></code></pre>"},{"absolutePath":"/home/runner/work/functional-examples/functional-examples/examples/mixed-plugins/tutorials/hello-world/index.ts","relativePath":"tutorials/hello-world/index.ts","raw":"/**\n * Hello World Tutorial\n *\n * This file is part of a YAML manifest example.\n * The metadata comes from meta.yml, not frontmatter.\n */\n\nfunction main() {\n  console.log('Hello from the tutorial!');\n  console.log('This example uses meta.yml for metadata.');\n}\n\nmain();\n","parsed":"/**\n * Hello World Tutorial\n *\n * This file is part of a YAML manifest example.\n * The metadata comes from meta.yml, not frontmatter.\n */\n\nfunction main() {\n  console.log('Hello from the tutorial!');\n  console.log('This example uses meta.yml for metadata.');\n}\n\nmain();\n","hunks":[],"language":"typescript","highlightedHtml":"<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-typescript\"><span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\">/**</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> * Hello World Tutorial</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> *</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> * This file is part of a YAML manifest example.</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> * The metadata comes from meta.yml, not frontmatter.</span></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"> */</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">function</span><span style=\"color:#B8D8F0\"> main</span><span style=\"color:#8FA4BE\">()</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E8EDF4\">  console</span><span style=\"color:#8FA4BE\">.</span><span style=\"color:#B8D8F0\">log</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#7CC9A0\">Hello from the tutorial!</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#8FA4BE\">);</span></span>\n<span class=\"line\"><span style=\"color:#E8EDF4\">  console</span><span style=\"color:#8FA4BE\">.</span><span style=\"color:#B8D8F0\">log</span><span style=\"color:#8FA4BE\">(</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#7CC9A0\">This example uses meta.yml for metadata.</span><span style=\"color:#8FA4BE\">'</span><span style=\"color:#8FA4BE\">);</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#B8D8F0\">main</span><span style=\"color:#8FA4BE\">();</span></span>\n<span class=\"line\"></span></code></pre>"},{"absolutePath":"/home/runner/work/functional-examples/functional-examples/examples/mixed-plugins/tutorials/hello-world/meta.yml","relativePath":"tutorials/hello-world/meta.yml","raw":"id: tutorial-hello-world\ntitle: Hello World Tutorial\ndescription: |\n  A tutorial example managed by the YAML manifest plugin.\n  This coexists with frontmatter-based examples in src/.\n","parsed":"id: tutorial-hello-world\ntitle: Hello World Tutorial\ndescription: |\n  A tutorial example managed by the YAML manifest plugin.\n  This coexists with frontmatter-based examples in src/.\n","hunks":[],"language":"yaml","highlightedHtml":"<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-yaml\"><span class=\"line\"><span style=\"color:#8EC8E8\">id</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#7CC9A0\"> tutorial-hello-world</span></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">title</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#7CC9A0\"> Hello World Tutorial</span></span>\n<span class=\"line\"><span style=\"color:#8EC8E8\">description</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8EC8E8\"> |</span></span>\n<span class=\"line\"><span style=\"color:#7CC9A0\">  A tutorial example managed by the YAML manifest plugin.</span></span>\n<span class=\"line\"><span style=\"color:#7CC9A0\">  This coexists with frontmatter-based examples in src/.</span></span>\n<span class=\"line\"></span></code></pre>"}],"metadata":{"id":"mixed-plugins","title":"Mixed Plugins","description":"Demonstrates using multiple plugins together with path-based\nconflict resolution via pathMappings configuration.\nsrc/ files use JavaScript plugin, tutorials/ use YAML manifest.\n","tags":["plugin","pathMappings","conflict-resolution"],"test":[{"name":"CLI scan works","options":{"command":"bash demo.sh"},"assertions":{"exitCode":0,"stdout":{"contains":"mixed-utils"}}}]},"extractorName":"meta-yml","displayPath":"mixed-plugins","hasReadme":true,"tags":["plugin","pathMappings","conflict-resolution"],"renderedProseHtml":"<h1>Mixed Plugins Example</h1>\n<p>This example demonstrates using multiple plugins together with conflict resolution via <code>pathMappings</code>.</p>\n<h2>Usage</h2>\n<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-bash\"><span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"># Scan and display examples</span></span>\n<span class=\"line\"><span style=\"color:#B8D8F0\">npx</span><span style=\"color:#7CC9A0\"> functional-examples</span><span style=\"color:#7CC9A0\"> </span><a href=\"/functional-examples/pr/9/api/functional-examples/scan\" class=\"typedoc-link\"><span style=\"color:#7CC9A0\">scan</span></a></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"># Output as JSON</span></span>\n<span class=\"line\"><span style=\"color:#B8D8F0\">npx</span><span style=\"color:#7CC9A0\"> functional-examples</span><span style=\"color:#7CC9A0\"> </span><a href=\"/functional-examples/pr/9/api/functional-examples/scan\" class=\"typedoc-link\"><span style=\"color:#7CC9A0\">scan</span></a><span style=\"color:#D4A94E\"> -f</span><span style=\"color:#7CC9A0\"> json</span></span></code></pre>\n<h2>The Problem</h2>\n<p>When both JavaScript and YAML manifest plugins are active, they may both try to claim the same files:</p>\n<ul>\n<li>JavaScript plugin claims any <code>.ts</code> file with frontmatter</li>\n<li>YAML manifest plugin claims any directory with <code>meta.yml</code></li>\n</ul>\n<p>If a TypeScript file is inside a directory with <code>meta.yml</code>, both plugins want it.</p>\n<h2>The Solution: pathMappings</h2>\n<p>Use <code>pathMappings</code> in your config to specify which extractor wins for each path pattern:</p>\n<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-json\"><span class=\"line\"><span style=\"color:#8FA4BE\">{</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">$schema</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">./.functional-examples/schema.json</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">scan</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    \"</span><span style=\"color:#A8D0F0\">include</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#7CC9A0\">src/**/*</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">tutorials/*</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">],</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    \"</span><span style=\"color:#A8D0F0\">exclude</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#7CC9A0\">**/node_modules/**</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">]</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  },</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">pathMappings</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">pattern</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">src/**</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">extractor</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">javascript-extractor</span><span style=\"color:#8FA4BE\">\"</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    },</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">pattern</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">tutorials/**</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">extractor</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">meta-yml</span><span style=\"color:#8FA4BE\">\"</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    }</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">}</span></span>\n<span class=\"line\"></span></code></pre>\n<h2>Project Structure</h2>\n<pre><code>mixed-plugins/\n├── src/                    # JavaScript plugin handles these\n│   └── utils.ts            # Has frontmatter metadata\n└── tutorials/              # YAML manifest plugin handles these\n    └── hello-world/\n        ├── meta.yml\n        └── index.ts\n</code></pre>\n<h2>Extractor Names</h2>\n<ul>\n<li><code>javascript-extractor</code> — The JavaScript/TypeScript plugin</li>\n<li><code>meta-yml</code> — The YAML manifest plugin</li>\n</ul>\n<p>These names are defined by each plugin and used in <code>pathMappings</code>.</p>","proseBlocks":[{"type":"html","html":"<h1>Mixed Plugins Example</h1>\n<p>This example demonstrates using multiple plugins together with conflict resolution via <code>pathMappings</code>.</p>\n<h2>Usage</h2>"},{"type":"code","file":"","language":"bash","code":"# Scan and display examples\nnpx functional-examples scan\n\n# Output as JSON\nnpx functional-examples scan -f json","highlightedHtml":"<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-bash\"><span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"># Scan and display examples</span></span>\n<span class=\"line\"><span style=\"color:#B8D8F0\">npx</span><span style=\"color:#7CC9A0\"> functional-examples</span><span style=\"color:#7CC9A0\"> scan</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6B8AAA;font-style:italic\"># Output as JSON</span></span>\n<span class=\"line\"><span style=\"color:#B8D8F0\">npx</span><span style=\"color:#7CC9A0\"> functional-examples</span><span style=\"color:#7CC9A0\"> scan</span><span style=\"color:#D4A94E\"> -f</span><span style=\"color:#7CC9A0\"> json</span></span></code></pre>"},{"type":"html","html":"<h2>The Problem</h2>\n<p>When both JavaScript and YAML manifest plugins are active, they may both try to claim the same files:</p>\n<ul>\n<li>JavaScript plugin claims any <code>.ts</code> file with frontmatter</li>\n<li>YAML manifest plugin claims any directory with <code>meta.yml</code></li>\n</ul>\n<p>If a TypeScript file is inside a directory with <code>meta.yml</code>, both plugins want it.</p>\n<h2>The Solution: pathMappings</h2>\n<p>Use <code>pathMappings</code> in your config to specify which extractor wins for each path pattern:</p>\n<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-json\"><span class=\"line\"><span style=\"color:#8FA4BE\">{</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">$schema</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">./.functional-examples/schema.json</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">scan</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    \"</span><span style=\"color:#A8D0F0\">include</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#7CC9A0\">src/**/*</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">tutorials/*</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">],</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    \"</span><span style=\"color:#A8D0F0\">exclude</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#7CC9A0\">**/node_modules/**</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">]</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  },</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  \"</span><span style=\"color:#A8D0F0\">pathMappings</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> [</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">pattern</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">src/**</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">extractor</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">javascript-extractor</span><span style=\"color:#8FA4BE\">\"</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    },</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    {</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">pattern</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">tutorials/**</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">,</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">      \"</span><span style=\"color:#A8D0F0\">extractor</span><span style=\"color:#8FA4BE\">\"</span><span style=\"color:#8FA4BE\">:</span><span style=\"color:#8FA4BE\"> \"</span><span style=\"color:#7CC9A0\">meta-yml</span><span style=\"color:#8FA4BE\">\"</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">    }</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">  ]</span></span>\n<span class=\"line\"><span style=\"color:#8FA4BE\">}</span></span></code></pre>"},{"type":"code","file":"","language":"text","code":"## Project Structure","highlightedHtml":"<pre class=\"shiki blueprint\" style=\"background-color:#122a48f2;color:#e8edf4\" tabindex=\"0\"><code class=\"language-text\"><span class=\"line\"><span>## Project Structure</span></span></code></pre>"},{"type":"html","html":"<p>mixed-plugins/\n├── src/                    # JavaScript plugin handles these\n│   └── utils.ts            # Has frontmatter metadata\n└── tutorials/              # YAML manifest plugin handles these\n└── hello-world/\n├── meta.yml\n└── index.ts</p>\n<pre><code>\n## Extractor Names\n\n- `javascript-extractor` — The JavaScript/TypeScript plugin\n- `meta-yml` — The YAML manifest plugin\n\nThese names are defined by each plugin and used in `pathMappings`.\n</code></pre>"}]}}}