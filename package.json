{
  "name": "@functional-examples/source",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "Craigory Coppola",
    "url": "https://craigory.dev"
  },
  "homepage": "https://craigory.dev/functional-examples",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentEnder/functional-examples.git"
  },
  "bugs": {
    "url": "https://github.com/AgentEnder/functional-examples/issues"
  },
  "scripts": {
    "sync-metadata": "node scripts/sync-package-metadata.mjs"
  },
  "private": true,
  "devDependencies": {
    "@functional-examples/devkit": "workspace:*",
    "@functional-examples/documentation": "workspace:*",
    "@functional-examples/javascript": "workspace:*",
    "@functional-examples/test": "workspace:*",
    "@functional-examples/yaml-manifest": "workspace:*",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/vitest": "catalog:",
    "@nx/workspace": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.0.1",
    "functional-examples": "workspace:*",
    "nx": "catalog:",
    "nx-github-pages": "^1.2.0",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "deploy": {
        "executor": "nx-github-pages:deploy",
        "options": {
          "directory": "./docs-site/dist/client"
        }
      },
      "hydrate-readmes": {
        "command": "tsx scripts/hydrate-readmes.mts",
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@cli-forge/parser": "link:../cli-forge/packages/parser",
    "cli-forge": "link:../cli-forge/packages/cli-forge"
  }
}
