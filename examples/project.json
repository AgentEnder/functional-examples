{
  "name": "examples",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "examples",
  "tags": ["scope:examples"],
  "implicitDependencies": ["examples/*"],
  "targets": {
    "build": {
      "command": "echo 'Examples do not need building'",
      "inputs": [],
      "outputs": []
    },
    "scan": {
      "command": "node node_modules/functional-examples/dist/cli scan examples",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "scan:json": {
      "command": "node node_modules/functional-examples/dist/cli scan examples scan examples -f json",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "command": "node node_modules/functional-examples/dist/cli scan examples test examples",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["^build"]
    },
    "generate": {
      "command": "tsx scripts/regenerate-examples.mts",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "command": "tsx scripts/typecheck-examples.mts",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["generate"]
    },
    "e2e": {
      "dependsOn": ["test", "typecheck"]
    }
  }
}
