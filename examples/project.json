{
  "name": "examples",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "examples",
  "tags": ["scope:examples"],
  "namedInputs": {
    "noInputs": []
  },
  "targets": {
    "build": {
      "command": "echo 'Examples do not need building'",
      "inputs": ["noInputs"],
      "outputs": []
    },
    "scan": {
      "command": "npx functional-examples scan examples",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "scan:json": {
      "command": "npx functional-examples scan examples -f json",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "command": "npx functional-examples test examples",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": ["^build"]
    }
  }
}
