// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`public API types > matches typedoc export snapshot 1`] = `
"interface BaseMetadata
  description?: string
  id: string
  title: string

interface Config
  generate?: GenerateConfig
  metadata?: JSONSchemaObject
  pathMappings?: PathMapping[]
  plugins?: PluginReference | Plugin<any>[]
  region?: RegionConfig
  root?: string
  scan?: ScanConfig

interface ConfigValidationError
  fix?: string
  location?: string
  message: string
  path: string

type ConfigWithRoot
  = Config & { root: string }

function createMatcher
  (pattern: string | string[]) => Promise<(path: string) => boolean>

interface Example<TMetadata = ExampleMetadata>
  description?: string
  extractorName: string
  files: ExampleFile[]
  id: string
  metadata: TMetadata
  rootPath: string
  title: string

class ExampleFile
  readonly absolutePath: string
  new (data: { absolutePath: string; hunks?: ParsedRegion[]; parsed?: string; raw?: string; relativePath: string }) => ExampleFile
  hunks?: ParsedRegion[]
  parsed?: string
  raw?: string
  region(id: string) => ParsedRegion | undefined
  readonly relativePath: string

type ExampleMetadata
  = ExampleMetadataRegistry extends { metadata: inferred } ? T : Record<string, unknown>

interface ExampleMetadataRegistry

interface Extractor<TMetadata = Record<string, unknown>>
  extract(candidates: Dirent<string>[], options: ExtractorOptions) => Promise<ExtractorResult<TMetadata>>
  readonly name: string

interface ExtractorConfig
  module: string
  name: string
  options?: Record<string, unknown>

type ExtractorConfigOrFunction<TMetadata = Record<string, unknown>>
  = ExtractorReference | Extractor<TMetadata>

interface ExtractorError
  cause?: Error
  message: string
  path: string

type ExtractorFactory<TOptions = Record<string, unknown>, TMetadata = Record<string, unknown>>
  = (options?: TOptions) => Extractor<TMetadata>

interface ExtractorOptions
  exclude?: string[]
  rootPath: string
  signal?: AbortSignal

type ExtractorReference
  = string | ExtractorConfig

interface ExtractorResult<TMetadata = Record<string, unknown>>
  claimedFiles: Set<string>
  errors: ExtractorError[]
  examples: Example<TMetadata>[]

interface FileContentsParser
  readonly name: string
  parse(context: FileParseContext) => FileParseContext | Promise<FileParseContext>

interface FileParseContext
  filePath: string
  hunks: ParsedRegion[]
  metadata: Record<string, unknown>
  parsed: string
  raw: string
  regionConfig: Required<Pick<RegionConfig, "startTag" | "endTag">>

interface GenerateConfig
  outputDir?: string

function glob
  (patterns: string | string[], options?: GlobOptions) => Promise<string[]>

interface GlobOptions
  absolute?: boolean
  cwd?: string
  expandDirectories?: boolean
  ignore?: string[]
  onlyFiles?: boolean

function isMatch
  (path: string, pattern: string | string[]) => Promise<boolean>

class JsonParseError
  readonly column?: number
  new (formatted: FormattedJsonError, filePath?: string) => JsonParseError
  readonly filePath?: string
  readonly line?: number

interface JSONSchemaObject
  const?: unknown
  description?: string
  enum?: unknown[]
  items?: JSONSchemaObject
  properties?: Record<string, JSONSchemaObject>
  required?: string[]
  type?: string

interface ParsedRegion
  content: string
  endLine: number
  id: string
  startLine: number

function parseJson
  <T = unknown>(content: string, filePath?: string) => Promise<T>

function parseYaml
  <T = unknown>(content: string, filePath?: string) => Promise<T>

interface PathMapping
  extractor: string
  pattern: string

interface Plugin<TMetadata = ExampleMetadata>
  readonly commands?: PluginCommands<TMetadata>
  readonly extensions?: string[]
  readonly extractor?: Extractor<TMetadata>
  readonly fileContentsParsers?: FileContentsParser[]
  readonly name: string
  readonly schemas?: PluginSchemas
  readonly validators?: PluginValidators<TMetadata>

type PluginCommands<TMetadata = ExampleMetadata>
  = CLI[] | (config: ResolvedConfig<TMetadata>) => CLI[] | Promise<CLI[]>

type PluginReference
  = string | [string, Record<string, unknown>]

interface PluginRegistryInterface
  getExtractors() => Extractor<Record<string, unknown>>[]
  getMetadataValidators() => PluginValidatorEntry<unknown>[]
  getOptionsValidators() => PluginValidatorEntry<unknown>[]
  getParsersForExtension(extension: string) => FileContentsParser[]
  getPlugins() => readonly Plugin<Record<string, unknown>>[]
  getPluginsForExtension(extension: string) => Plugin<Record<string, unknown>>[]
  getSchemas() => PluginSchemaEntry[]
  register(plugin: Plugin) => void

interface PluginSchemaEntry
  metadata?: string
  options?: string
  packageName?: string
  pluginName: string

interface PluginSchemas
  metadata?: string
  options?: string

interface PluginValidatorEntry<T = unknown>
  pluginName: string
  validate: (value: T) => ValidationResult

interface PluginValidators<TMetadata = Record<string, unknown>>
  metadata?: (metadata: TMetadata) => ValidationResult
  options?: (options: unknown) => ValidationResult

interface RegionConfig
  endTag?: string
  fileExtensionMap?: Record<string, string | RegExp[]>
  startTag?: string

interface ResolvedConfig<TMetadata = ExampleMetadata>
  extractors: Extractor<TMetadata>[]
  generate?: GenerateConfig
  metadata?: JSONSchemaObject
  pathMappings: PathMapping[]
  plugins: Plugin<TMetadata>[]
  region: Required<RegionConfig>
  registry: PluginRegistryInterface
  root: string
  scan: Required<ScanConfig>
  validationErrors: ConfigValidationError[]

interface ScanConfig
  exclude?: string[]
  include?: string[]
  root?: string

class ScannedExample<TMetadata = ExampleMetadata>
  new <TMetadata = Record<string, unknown>>(data: Example<TMetadata> & { displayPath: string }) => ScannedExample<TMetadata>
  readonly description?: string
  readonly displayPath: string
  readonly extractorName: string
  file(relativePath: string) => ExampleFile
  readonly files: ExampleFile[]
  readonly id: string
  readonly metadata: TMetadata
  readonly rootPath: string
  readonly title: string

function tryParseJson
  <T = unknown>(content: string, filePath?: string) => Promise<{ data: T; success: true } | { error: JsonParseError; success: false }>

function tryParseYaml
  <T = unknown>(content: string, filePath?: string) => Promise<{ data: T; success: true } | { error: YamlParseError; success: false }>

type TypeGuard<T>
  = (val: unknown) => T is unknown

interface ValidationError
  message: string
  path: string

interface ValidationResult
  errors: ValidationError[]
  success: boolean

class YamlParseError
  readonly column?: number
  new (message: string, options?: { column?: number; filePath?: string; line?: number }) => YamlParseError
  readonly filePath?: string
  readonly line?: number"
`;
