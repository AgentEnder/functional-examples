{
  "name": "@functional-examples/devkit",
  "version": "0.0.0-alpha.5",
  "description": "Plugin development kit for functional-examples",
  "author": {
    "name": "Craigory Coppola",
    "url": "https://craigory.dev"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-docs": "typedoc --options typedoc.json"
  },
  "dependencies": {
    "cli-forge": "catalog:"
  },
  "peerDependencies": {
    "jsonc-parser": ">=3.0.0",
    "json5": ">=2.0.0",
    "picomatch": ">=4.0.0",
    "tinyglobby": ">=0.2.0",
    "yaml": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "jsonc-parser": {
      "optional": true
    },
    "json5": {
      "optional": true
    },
    "picomatch": {
      "optional": true
    },
    "tinyglobby": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.2",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "picomatch": "catalog:",
    "tinyglobby": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "homepage": "https://craigory.dev/functional-examples",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentEnder/functional-examples.git"
  },
  "bugs": {
    "url": "https://github.com/AgentEnder/functional-examples/issues"
  }
}
