{
  "name": "@functional-examples/documentation",
  "version": "0.0.0-alpha.5",
  "type": "module",
  "description": "Documentation generation plugin for functional-examples",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-docs": "typedoc --options typedoc.json"
  },
  "peerDependencies": {
    "functional-examples": "0.0.0-alpha.5"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  },
  "dependencies": {
    "@functional-examples/devkit": "workspace:*",
    "cli-forge": "catalog:",
    "eta": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@functional-examples/devkit": "workspace:*",
    "@types/node": "catalog:",
    "functional-examples": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "license": "MIT",
  "author": {
    "name": "Craigory Coppola",
    "url": "https://craigory.dev"
  },
  "homepage": "https://craigory.dev/functional-examples",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentEnder/functional-examples.git"
  },
  "bugs": {
    "url": "https://github.com/AgentEnder/functional-examples/issues"
  }
}
