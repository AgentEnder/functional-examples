{
  "name": "@e2e/docs-output-name",
  "private": true,
  "type": "module",
  "description": "Verifies docs.outputName metadata controls the generated filename",
  "main": "./src/index.js",
  "functional-examples": {
    "title": "Custom Output Name",
    "tags": ["e2e", "docs", "outputName"],
    "docs": {
      "outputName": "api-reference"
    },
    "test": {
      "name": "output uses custom filename from docs.outputName",
      "steps": [
        {
          "command": "rm -rf ./tmp-outname"
        },
        {
          "command": "npx functional-examples documentation --filter docs-output-name --output ./tmp-outname",
          "assertions": {
            "exitCode": 0,
            "stdout": { "contains": "1 example(s) documented" },
            "file": {
              "path": "./tmp-outname/api-reference.md",
              "contains": "# Custom Output Name"
            },
            "not": { "file": { "path": "./tmp-outname/docs-output-name.md" } }
          }
        },
        {
          "command": "rm -rf ./tmp-outname"
        }
      ]
    }
  }
}
